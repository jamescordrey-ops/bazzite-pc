[Unit]
Description=SARA search server (FSSA Medicaid search)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sara
EnvironmentFile=%h/sara/sara.env
ExecStart=/usr/bin/python3 %h/sara/fssa_search_server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
